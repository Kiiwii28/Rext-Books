# Copy to .env and fill in your key. .env is gitignored.

# Which provider generation runs against. A choice saved in ⚙ Settings wins.
# LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional second provider — only needed if you switch to Gemini.
# GEMINI_API_KEY=AIza-your-key-here
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Generic overrides for whichever provider is active:
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
